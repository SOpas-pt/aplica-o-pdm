<?xml version="1.0" encoding="utf-8"?>
<!-- Linha de uma conquista (Peixedex): ícone, título, descrição e progresso. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <ImageView
        android:id="@+id/icone"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_trofeu" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:id="@+id/txtTitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/cp_texto"
            android:textSize="14sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/txtDescricao"
            style="@style/Texto.Suave"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/barra"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:max="100"
            app:indicatorColor="@color/cp_primaria"
            app:trackColor="@color/cp_cartao2"
            app:trackCornerRadius="4dp"
            app:trackThickness="6dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/txtValor"
        style="@style/Texto.Suave"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:textStyle="bold" />
</LinearLayout>
