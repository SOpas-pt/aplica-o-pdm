<?xml version="1.0" encoding="utf-8"?>
<!-- Novo pesqueiro (ou editar pesqueiro do utilizador) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cp_fundo"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/margem_cabecalho"
        android:paddingEnd="@dimen/margem_cabecalho">

        <ImageButton
            android:id="@+id/btnVoltar"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_botao_redondo"
            android:contentDescription="@string/voltar"
            android:src="@drawable/ic_voltar"
            android:tint="@color/cp_texto" />

        <TextView
            android:id="@+id/txtTitulo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:textColor="@color/cp_texto"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/margem_ecra"
            android:paddingEnd="@dimen/margem_ecra"
            android:paddingBottom="24dp">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/caixaNome"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/novo_nome_hint">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtNome"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapWords"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="@string/novo_distrito_hint">
                <AutoCompleteTextView
                    android:id="@+id/edtDistrito"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Marcar no mapa (opcional, para mais precisão que o centro do distrito) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_cartao"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_pin" android:tint="@color/cp_destaque" android:importantForAccessibility="no" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/novo_localizacao_exata" android:textColor="@color/cp_texto" android:textSize="14sp" android:textStyle="bold" />
                    <TextView android:id="@+id/txtMarcado" style="@style/Texto.Suave" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/novo_centro_distrito" />
                </LinearLayout>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMarcar"
                    style="@style/Botao.Contorno"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="40dp"
                    android:text="@string/marcar"
                    android:textSize="13sp"
                    app:icon="@drawable/ic_mapa"
                    app:iconGravity="textStart" />
            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="@string/novo_tipo_hint">
                <AutoCompleteTextView
                    android:id="@+id/edtTipo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView style="@style/Texto.Rotulo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="@string/novo_tipo_agua" />
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/grupoAgua"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:selectionRequired="true"
                app:singleSelection="true">
                <Button android:id="@+id/aguaDoce" style="@style/Botao.Alternar" android:layout_width="0dp" android:layout_weight="1" android:text="@string/agua_doce" />
                <Button android:id="@+id/aguaSalgada" style="@style/Botao.Alternar" android:layout_width="0dp" android:layout_weight="1" android:text="@string/agua_salgada" />
                <Button android:id="@+id/aguaSalobra" style="@style/Botao.Alternar" android:layout_width="0dp" android:layout_weight="1" android:text="@string/agua_salobra" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <TextView style="@style/Texto.Rotulo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="@string/novo_licencas_exigidas" />
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipsLicencas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp" />

            <TextView style="@style/Texto.Rotulo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="@string/novo_especies_presentes" />
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipsEspecies"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGuardar"
                style="@style/Botao.Principal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/guardar"
                app:icon="@drawable/ic_visto"
                app:iconGravity="textStart" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnApagar"
                style="@style/Botao.Contorno"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/apagar_licenca"
                android:textColor="@color/cp_erro_texto"
                android:visibility="gone"
                app:icon="@drawable/ic_apagar"
                app:iconGravity="textStart"
                app:iconTint="@color/cp_erro_texto"
                app:strokeColor="@color/cp_erro_texto" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
