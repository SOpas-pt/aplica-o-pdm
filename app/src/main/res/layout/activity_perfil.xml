<?xml version="1.0" encoding="utf-8"?>
<!-- Editar perfil (nome e, no futuro, fotografia) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cp_fundo"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/margem_cabecalho"
        android:paddingEnd="@dimen/margem_cabecalho">

        <ImageButton
            android:id="@+id/btnVoltar"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_botao_redondo"
            android:contentDescription="@string/voltar"
            android:src="@drawable/ic_voltar"
            android:tint="@color/cp_texto" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="@string/perf_titulo"
            android:textColor="@color/cp_texto"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="@dimen/margem_perfil"
        android:paddingTop="24dp"
        android:paddingEnd="@dimen/margem_perfil"
        android:paddingBottom="24dp">

        <FrameLayout
            android:id="@+id/caixaAvatar"
            android:layout_width="92dp"
            android:layout_height="92dp"
            android:background="@drawable/bg_avatar"
            android:clickable="true"
            android:focusable="true"
            android:clipToOutline="true">
            <TextView
                android:id="@+id/txtIniciais"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textColor="@color/white"
                android:textSize="34sp"
                android:textStyle="bold" />
            <ImageView
                android:id="@+id/imgFotoPerfil"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:visibility="gone"
                android:contentDescription="@string/perf_foto_desc" />
        </FrameLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTrocarFoto"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/perf_trocar_foto"
            app:icon="@drawable/ic_camara"
            app:iconGravity="textStart" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:hint="@string/perf_nome">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edtNome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPersonName|textCapWords"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGuardar"
            style="@style/Botao.Principal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/guardar"
            app:icon="@drawable/ic_visto"
            app:iconGravity="textStart" />
    </LinearLayout>
</LinearLayout>
