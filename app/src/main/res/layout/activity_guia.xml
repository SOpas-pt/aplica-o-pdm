<?xml version="1.0" encoding="utf-8"?>
<!-- Guia de espécies (filtros por tipo de água, grelha de todas as espécies) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cp_fundo"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/margem_cabecalho"
        android:paddingEnd="@dimen/margem_cabecalho">

        <ImageButton
            android:id="@+id/btnVoltar"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_botao_redondo"
            android:contentDescription="@string/voltar"
            android:src="@drawable/ic_voltar"
            android:tint="@color/cp_texto" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="@string/menu_guia"
            android:textColor="@color/cp_texto"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/margem_ecra"
        android:paddingEnd="@dimen/margem_ecra"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipsFiltro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleLine="true"
            app:singleSelection="true" />
    </HorizontalScrollView>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/margem_ecra"
            android:paddingTop="12dp"
            android:paddingEnd="@dimen/margem_ecra"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/txtContagem"
                style="@style/Texto.Suave"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:id="@+id/grelha"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
