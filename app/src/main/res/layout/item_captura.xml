<?xml version="1.0" encoding="utf-8"?>
<!-- Linha de uma captura no Histórico. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <!-- Miniatura (foto ou ilustração) -->
        <FrameLayout
            android:layout_width="56dp"
            android:layout_height="44dp">

            <pt.ubi.di.pdm.aplicacaopesca.ui.PeixeView
                android:id="@+id/peixeMini"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <ImageView
                android:id="@+id/imgMini"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:visibility="gone"
                android:importantForAccessibility="no" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtNome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/cp_texto"
                android:textSize="14.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtDetalhes"
                style="@style/Texto.Suave"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtRecorde"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_caixa_info"
            android:drawablePadding="4dp"
            android:paddingStart="8dp"
            android:paddingTop="4dp"
            android:paddingEnd="8dp"
            android:paddingBottom="4dp"
            android:text="@string/cap_recorde"
            android:textColor="@color/cp_aviso_texto"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:drawableStartCompat="@drawable/ic_trofeu"
            app:drawableTint="@color/cp_aviso_texto" />

        <ImageButton
            android:id="@+id/btnPartilhar"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_botao_redondo"
            android:contentDescription="@string/ficha_partilhar"
            android:src="@drawable/ic_partilhar"
            android:tint="@color/cp_texto" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
