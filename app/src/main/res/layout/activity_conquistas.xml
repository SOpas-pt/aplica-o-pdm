<?xml version="1.0" encoding="utf-8"?>
<!-- Conquistas (resumo e lista de todas as conquistas com progresso) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cp_fundo"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/margem_cabecalho"
        android:paddingEnd="@dimen/margem_cabecalho">

        <ImageButton
            android:id="@+id/btnVoltar"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_botao_redondo"
            android:contentDescription="@string/voltar"
            android:src="@drawable/ic_voltar"
            android:tint="@color/cp_texto" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="@string/conq_titulo"
            android:textColor="@color/cp_texto"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/margem_ecra"
            android:paddingTop="4dp"
            android:paddingEnd="@dimen/margem_ecra"
            android:paddingBottom="24dp">

            <!-- Resumo -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_cartao"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <FrameLayout android:layout_width="84dp" android:layout_height="84dp">
                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/anel"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:max="100"
                        app:indicatorColor="@color/cp_primaria"
                        app:indicatorSize="84dp"
                        app:trackColor="@color/cp_cartao2"
                        app:trackCornerRadius="6dp"
                        app:trackThickness="9dp" />
                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_trofeu"
                        android:tint="@color/cp_aviso_texto" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/txtResumo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/cp_texto"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                    <TextView
                        style="@style/Texto.Suave"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/conq_sub" />
                </LinearLayout>
            </LinearLayout>

            <!-- Lista -->
            <LinearLayout
                android:id="@+id/listaConquistas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
