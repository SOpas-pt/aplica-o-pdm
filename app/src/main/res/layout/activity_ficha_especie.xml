<?xml version="1.0" encoding="utf-8"?>
<!-- Ficha da espécie (abre a partir da Peixedex ou da grelha de um local) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cp_fundo"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/margem_cabecalho"
        android:paddingEnd="@dimen/margem_cabecalho">

        <ImageButton
            android:id="@+id/btnVoltar"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_botao_redondo"
            android:contentDescription="@string/voltar"
            android:src="@drawable/ic_voltar"
            android:tint="@color/cp_texto" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="@string/ficha_titulo"
            android:textColor="@color/cp_texto"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/margem_ecra"
            android:paddingEnd="@dimen/margem_ecra"
            android:paddingBottom="24dp">

            <!-- Chips de outras espécies para saltar entre elas -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipsSalto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleLine="true"
                    app:singleSelection="true" />
            </HorizontalScrollView>

            <!-- Ilustração (silhueta se bloqueada) · a foto real cobre-a quando existir -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">
                <pt.ubi.di.pdm.aplicacaopesca.ui.PeixeView
                    android:id="@+id/peixe"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
                <ImageView
                    android:id="@+id/imgFoto"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:background="#0A2C48"
                    android:scaleType="centerCrop"
                    android:visibility="gone"
                    android:importantForAccessibility="no" />
            </FrameLayout>

            <TextView
                android:id="@+id/txtNome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/cp_texto"
                android:textSize="23sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/txtLatim"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/cp_texto_suave"
                android:textSize="13sp"
                android:textStyle="italic" />

            <!-- Cartão de informação (habitat, época, tamanho, iscos, identificar) -->
            <LinearLayout
                android:id="@+id/cartaoInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_cartao"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp" />

            <!-- Onde pode pescar -->
            <TextView
                android:id="@+id/tituloOnde"
                style="@style/Texto.Seccao"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/ficha_onde_pescar" />
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipsOnde"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp" />

            <!-- Botões: Partilhar + Fotografar/Registar -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPartilhar"
                style="@style/Botao.Contorno"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/ficha_partilhar"
                app:icon="@drawable/ic_partilhar"
                app:iconGravity="textStart" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFotografar"
                style="@style/Botao.Principal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:icon="@drawable/ic_camara"
                app:iconGravity="textStart" />

            <TextView
                style="@style/Texto.Suave"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="@string/aviso_indicativo" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
