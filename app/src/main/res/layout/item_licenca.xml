<?xml version="1.0" encoding="utf-8"?>
<!-- Uma licença do utilizador, com barra de progresso colorida -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/txtNome" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="@color/cp_texto" android:textSize="14.5sp" android:textStyle="bold" />
            <TextView android:id="@+id/txtEstado" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" />
        </LinearLayout>

        <TextView android:id="@+id/txtDetalhe" style="@style/Texto.Suave" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/barra"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:max="100"
            app:trackCornerRadius="5dp"
            app:trackThickness="9dp"
            app:trackColor="@color/cp_cartao2" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="horizontal">
            <TextView android:id="@+id/txtDias" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textSize="12sp" android:textStyle="bold" />
            <TextView android:id="@+id/txtUso" style="@style/Texto.Suave" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
