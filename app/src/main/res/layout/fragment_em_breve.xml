<?xml version="1.0" encoding="utf-8"?>
<!-- Ecrã ainda em desenvolvimento (fases seguintes) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <ImageView android:id="@+id/ico" android:layout_width="44dp" android:layout_height="44dp" android:src="@drawable/ic_peixe" android:tint="@color/cp_texto_suave" android:importantForAccessibility="no" />
    <TextView android:id="@+id/txtTitulo" style="@style/Texto.Titulo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" />
    <TextView style="@style/Texto.Suave" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="center" android:text="@string/em_breve" />
</LinearLayout>
